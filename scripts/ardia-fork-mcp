#!/bin/bash
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
export PYTHONPATH="$repo/apps/cli${PYTHONPATH:+:$PYTHONPATH}"
helper="$repo/output/agent-tools/Ardia Fork MCP"
if [[ ! -x "$helper" ]]; then
  python3 "$repo/scripts/build-agent-helper.py" >&2
fi
exec "$helper" -m ardia_cli.mcp "$@"
